    <outline text="Scraped news">
      <outline text="Community site" type="HTML+XPath" xmlUrl="https://community.example.net" htmlUrl="https://community.example.net/" description="RSS-Feed von Community site" frss:unicityCriteria="link" frss:xPathItem="//article[contains(@class, 'item news-item')]" frss:xPathItemTitle=".//h3[@class='title']/a/text()" frss:xPathItemContent="string(./div[@class='post-preview']/div[@class='description']/p)" frss:xPathItemUri=".//h3[@class='title']/a/@href" frss:xPathItemTimestamp=".//div[@class='date']/text()" frss:xPathItemTimeFormat="F d, Y" frss:xPathItemThumbnail="concat('https://community.example.net', .//div[contains(@class, 'image')]//img/@src)" frss:xPathItemUid="concat(&#13;&#10;  substring-after(.//h3[@class='title']/a/@href, '/news/'),&#13;&#10;  '-',&#13;&#10;  translate(.//div[@class='date'], ' ', '-')&#13;&#10;)"/>
      <outline text="Publisher news" type="HTML+XPath" xmlUrl="https://www.publisher.example/de-de/games/title/news" htmlUrl="https://www.publisher.example/de-de/games/title/news" description="RSS-Feed von Publisher news" frss:xPathItem="//ea-tile" frss:xPathItemTitle=".//h3/text()" frss:xPathItemUri=".//ea-cta/a/@href" frss:xPathItemTimestamp=".//div[following-sibling::ea-cta]/text()" frss:xPathItemTimeFormat="d.m.Y" frss:xPathItemThumbnail="./@media" frss:xPathItemUid="substring-after(.//h3[@class='headline']/a/@href, '/news/')"/>
      <outline text="Fan news &amp; more" type="rss" xmlUrl="https://fans.example.de/api/feeds/posts" htmlUrl="https://fans.example.de/" description="Fan news &amp; more"/>
      <outline text="APK mirror listing" type="rss" xmlUrl="https://apk.example.com/apk/vendor/app/feed/" htmlUrl="https://apk.example.com/apk/vendor/app/" description="Free and safe Android APK downloads" frss:cssFullContent=".notes"/>
      <outline text="Competitive blog" type="rss" xmlUrl="https://www.blogger.example/feeds/1234567890/posts/default" htmlUrl="http://competitive.blogspot.example/" description="Covering the game for new players and it's competitive community" frss:unicityCriteria="link" frss:unicityCriteriaForced="true"/>
    </outline>
    <outline text="Mods">
      <outline text="Mod A - Mod DB" type="rss" xmlUrl="https://rss.moddb.example/games/mod-a/articles/feed/rss.xml" htmlUrl="https://www.moddb.example/games/mod-a/articles" description="Subscribe to the Mod A article feed, and get the latest updates as they are posted." frss:cssFullContent=".bodyarticle"/>
      <outline text="Mod B - Mod DB" type="rss" xmlUrl="https://rss.moddb.example/games/mod-b/articles/feed/rss.xml" htmlUrl="https://www.moddb.example/games/mod-b/articles" description="Subscribe to the Mod B article feed, and get the latest updates as they are posted." frss:cssFullContent=".bodyarticle"/>
      <outline text="Forum news" type="rss" xmlUrl="https://forum.example.games/forums/rss/1-recent-news.xml/" htmlUrl="https://forum.example.games/forums/rss/1-recent-news.xml/" description="Recent News" frss:cssFullContent=".ipsSpoiler_contents"/>
      <outline text="Open source engine" type="rss" xmlUrl="https://engine.example.net/news/atom/" htmlUrl="https://engine.example.net/" description="An open source engine that recreates &amp; modernizes classic games."/>
