    </outline>
    <outline text="Empty One"/>
    <outline text="Beta">
      <outline text="Scraped List" type="HTML+XPath" xmlUrl="https://list.example.net" htmlUrl="https://list.example.net/" description="Scraped list page" frss:unicityCriteria="link" frss:xPathItem="//li[contains(@class, 'entry row')]" frss:xPathItemTitle=".//span[@class='name']/a/text()" frss:xPathItemContent="string(./div[@class='teaser']/div[@class='text']/p)" frss:xPathItemUri=".//span[@class='name']/a/@href" frss:xPathItemTimestamp=".//time/text()" frss:xPathItemTimeFormat="F d, Y" frss:xPathItemThumbnail="concat('https://list.example.net', .//figure//img/@src)" frss:xPathItemUid="concat(&#13;&#10;  substring-after(.//span[@class='name']/a/@href, '/item/'),&#13;&#10;  '-',&#13;&#10;  translate(.//time, ' ', '-')&#13;&#10;)"/>
      <outline text="Scraped Cards" type="HTML+XPath" xmlUrl="https://cards.example.com/section/updates" htmlUrl="https://cards.example.com/section/updates" description="Scraped card grid" frss:xPathItem="//x-card" frss:xPathItemTitle=".//h4/text()" frss:xPathItemUri=".//x-link/a/@href" frss:xPathItemTimestamp=".//p[following-sibling::x-link]/text()" frss:xPathItemTimeFormat="d.m.Y" frss:xPathItemThumbnail="./@image" frss:xPathItemUid="substring-after(.//h4[@class='card-title']/a/@href, '/updates/')"/>
      <outline text="Tools &amp; Tips" type="rss" xmlUrl="https://tips.example.org/api/feed" htmlUrl="https://tips.example.org/" description="Tools &amp; tips"/>
      <outline text="Release Notes" type="rss" xmlUrl="https://releases.example.com/app/feed/" htmlUrl="https://releases.example.com/app/" description="Release notes" frss:cssFullContent=".notes"/>
      <outline text="Mirror Blog" type="rss" xmlUrl="https://www.blog.example/feeds/42/posts/default" htmlUrl="http://mirror.blog.example/" description="A blog that republishes posts and it's sometimes duplicated" frss:unicityCriteria="link" frss:unicityCriteriaForced="true"/>
    </outline>
    <outline text="Gamma">
      <outline text="Articles One" type="rss" xmlUrl="https://rss.articles.example/one/feed/rss.xml" htmlUrl="https://www.articles.example/one" description="Article feed one" frss:cssFullContent=".article-body"/>
      <outline text="Articles Two" type="rss" xmlUrl="https://rss.articles.example/two/feed/rss.xml" htmlUrl="https://www.articles.example/two" description="Article feed two" frss:cssFullContent=".article-body"/>
      <outline text="Forum Announcements" type="rss" xmlUrl="https://forum.example.net/rss/announcements.xml/" htmlUrl="https://forum.example.net/rss/announcements.xml/" description="Announcements" frss:cssFullContent=".post-contents"/>
